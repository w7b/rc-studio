{
  "profile": "product-admin",
  "sourceRoots": ["apps/frontend/src"],
  "locale": "pt-BR",
  "canonicalMap": "UX-CONTRACT.md",
  "requiredCapabilities": ["Select/Listbox", "Form", "Scrollbar", "Toast", "CRUD"],
  "ownership": {"Select/Listbox": "native", "SearchableListbox": "SearchSelect.jsx", "Date": "native"},
  "requiredCommands": ["unit", "build", "format"],
  "commands": {
    "unit": "npm --prefix apps/frontend test",
    "build": "npm --prefix apps/frontend run build",
    "format": "npm --prefix apps/frontend run format:check"
  },
  "evidence": {
    "crudFullFlow": "docs/frontend-review.md",
    "failurePaths": "apps/backend/tests/test_admin.py"
  }
}
