# Copie para data/platform/.env. Credenciais ficam fora das pastas das lojas.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_IMAGE_MODEL=gpt-image-2

# build.nvidia.com. Uma chave serve para o texto (Nemotron 3 Ultra) e para a arte (FLUX.1 dev).
NVIDIA_API_KEY=
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_IMAGE_URL=https://ai.api.nvidia.com/v1/genai
# Hugging Face Inference Providers: um token alcanca centenas de modelos abertos.
# Gere um token fine-grained com a permissao "Make calls to Inference Providers".
HF_TOKEN=
# HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1

# Qwen-Image 2.1 nao e servido por nenhum provedor da Hugging Face; o modelo roda no
# endpoint que voce hospedar. Sem esta variavel a opcao aparece como indisponivel.
# QWEN_IMAGE_URL=http://host.docker.internal:8001/v1/infer
# QWEN_IMAGE_API_KEY=

# Qwen-Image-Edit NIM hospedado por você: endpoint completo; não é a API pública NVIDIA.
# No Docker Desktop, host.docker.internal permite acessar um servidor no computador host.
# QWEN_IMAGE_EDIT_URL=http://host.docker.internal:8000/v1/infer
# QWEN_IMAGE_EDIT_API_KEY=
MAX_TURNS=12
REQUEST_TIMEOUT_SECONDS=4800
# Teto por agente. Um agente travado nao consome mais o tempo dos demais.
AGENT_TIMEOUT_SECONDS=600

# NGINX (Compose). Padrão: acesso local http://127.0.0.1:8765.
# Para interpolar o Compose, use --env-file data/platform/.env.
# STUDIO_BIND_ADDRESS=127.0.0.1
# STUDIO_HTTP_PORT=8765
# STUDIO_BACKEND_PORT=8766  # somente compose.proxy-local.yaml, Docker Desktop
# Docker inicia com login e PostgreSQL por padrão. Sem login é uma opção explícita:
# STUDIO_MODE=standalone

# Optional absolute paths. Defaults target the monorepo checkout.
# REALCENTER_DATA_ROOT=C:/path/to/studio-ai/data/tenants/default
# REALCENTER_TENANTS_ROOT=C:/path/to/studio-ai/data/tenants
# REALCENTER_RESOURCES_ROOT=C:/path/to/studio-ai/resources
# REALCENTER_STATIC_ROOT=C:/path/to/studio-ai/apps/frontend/dist

# --- Implantação compartilhada (multi-loja) ---
# Onde o .env de credenciais é lido. Em SaaS aponta para o diretório da plataforma, para
# que a raiz de dados de uma loja nunca possa fornecer chave nem endpoint de API.
# REALCENTER_ENV_ROOT=C:/path/to/studio-ai/data/platform
# O Docker define /app/data/platform e /app/data/tenants nos dois serviços.
# Hosts aceitos além do par loopback. Obrigatório atrás de proxy reverso.
# REALCENTER_PUBLIC_HOST=studio.exemplo.com.br
# Esquema público. O TLS termina no proxy, então isso não pode ser deduzido do socket.
# REALCENTER_PUBLIC_SCHEME=https
# IPs/nomes dos proxies confiáveis, separados por vírgula. Vazio ignora X-Real-IP.
# O Compose principal define nginx; não use nomes controlados por clientes.
# REALCENTER_TRUSTED_PROXIES=nginx
# Permite que a raiz de dados substitua instruções de agente e a política. Desligado por
# padrão: em implantação compartilhada isso silenciaria agent-policy.md.
# REALCENTER_ALLOW_ROOT_OVERRIDES=1

# --- Identidade (modo compartilhado) ---
# Fora do Docker, DATABASE_URL habilita Postgres e login; ausente mantém standalone.
# No Compose, STUDIO_MODE=shared é o padrão: conecta ao serviço db usando os campos
# POSTGRES_DB, POSTGRES_USER e POSTGRES_PASSWORD, mesmo sem DATABASE_URL.
# DATABASE_URL pode substituir essa conexão por um banco externo.
# DATABASE_URL=postgresql://studio:studio@db:5432/studio
# Login com Google (OpenID Connect). O redirect_uri registrado no console do Google
# precisa ser https://SEU_HOST/api/auth/google/callback — o Google exige HTTPS fora
# de localhost, então o TLS precisa estar no ar antes de habilitar isto.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Força o atributo Secure do cookie. Vazio decide pelo esquema público.
# REALCENTER_COOKIE_SECURE=1
