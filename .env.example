# Secrets may remain in realcenter-marketing-ai/.env (legacy-compatible).
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_IMAGE_MODEL=gpt-image-2
MAX_TURNS=12
REQUEST_TIMEOUT_SECONDS=180

# Optional absolute paths. Defaults target the monorepo checkout.
# REALCENTER_DATA_ROOT=C:/path/to/create-rc-agents/realcenter-marketing-ai
# REALCENTER_RESOURCES_ROOT=C:/path/to/create-rc-agents/resources
# REALCENTER_STATIC_ROOT=C:/path/to/create-rc-agents/apps/frontend/dist
